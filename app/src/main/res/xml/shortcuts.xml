<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutDisabledMessage="@string/focus_mode"
        android:enabled="true"
        android:icon="@drawable/focus_mode_icon"
        android:shortcutShortLabel="@string/focus_mode"
        android:shortcutId="infoxus_focus_mode_shortcut"
        android:shortcutLongLabel="@string/focus_mode">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="mina.infoxus"
            android:targetClass="mina.infoxus.ui.activity.ShortcutActivity" />
        <categories android:name="infoxus" />
        <capability-binding android:key="actions.intent.CREATE_MESSAGE" />
    </shortcut>
    <shortcut
        android:shortcutId="infoxus_security_marker"
        android:enabled="true"
        android:icon="@drawable/app_icon"
        android:shortcutShortLabel="@string/security_marker"
        android:shortcutLongLabel="@string/security_marker">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="mina.infoxus"
            android:targetClass="mina.infoxus.ui.activity.ShortcutActivity" />
    </shortcut>
</shortcuts>
  
