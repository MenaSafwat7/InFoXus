<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.fragments.anti_uninstall.SetupTimedModeFragment">


    <TextView
        android:id="@+id/textView3"
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/timed_mode"
        android:textColor="@color/white"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/textView6"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:paddingBottom="8dp"
        android:text="@string/timed_mode_desc"
        android:textColor="@color/text_secondary" />

    <CalendarView
        android:id="@+id/calendarView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <CheckBox
        android:id="@+id/block_changes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Block making changes to blockers during this period."
        android:textColor="@color/white" />

    <Button
        android:id="@+id/turn_on_timed"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/turn_on_anti_uninstall"
        android:textAllCaps="false"
        android:textColor="@color/bg_dark"
        android:textStyle="bold"
        app:backgroundTint="@color/lavender_primary"
        app:cornerRadius="12dp" />
</LinearLayout>